Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Cell Size: 10
      Plane Cell Count: 40
      Reference Frame: world
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: CQ01 V2.1 Terrain Buildings Goals
      Topic:
        Value: /cq01_v2/markers
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Reference Path
      Topic:
        Value: /cq01_v2/reference_path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Line Style: Lines
      Line Width: 0.8
    - Class: rviz_default_plugins/PoseArray
      Enabled: true
      Name: Waypoints
      Topic:
        Value: /cq01_v2/waypoints
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Shape: Arrow (Flat)
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Collision Cloud
      Topic:
        Value: /cq01_v2/collision_cloud
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
  Enabled: true
  Global Options:
    Background Color: 38; 42; 46
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 430
      Focal Point:
        X: 165
        Y: 0
        Z: 42
      Pitch: 0.50
      Yaw: 1.48
      Near Clip Distance: 0.01
Window Geometry:
  Height: 850
  Width: 1450
