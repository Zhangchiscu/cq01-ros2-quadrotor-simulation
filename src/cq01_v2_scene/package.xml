<?xml version="1.0"?>
<package format="3">
  <name>cq01_v2_scene</name>
  <version>7.1.2</version>
  <description>CQ-01 V7.1.2 fixes stale planner-status handoff by keeping the original dispatcher alive and inactive during the prelude.</description>
  <maintainer email="taccettabellus@gmail.com">Xianzhe Zhang</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>drone_dynamics</exec_depend>
  <exec_depend>drone_controller</exec_depend>
  <exec_depend>drone_planner_3d</exec_depend>
  <exec_depend>drone_trajectory</exec_depend>
  <exec_depend>drone_bringup</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
