#!/usr/bin/env bash
set -e

X="${1:-0.0}"
Y="${2:-0.0}"
Z="${3:-1.5}"

echo "Publishing goal: x=${X}, y=${Y}, z=${Z}, yaw=0 deg"

ros2 topic pub --once \
  /drone/goal \
  geometry_msgs/msg/PoseStamped \
  "{header: {frame_id: 'map'}, pose: {position: {x: ${X}, y: ${Y}, z: ${Z}}, orientation: {x: 0.0, y: 0.0, z: 0.0, w: 1.0}}}"
