Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.50
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 155; 155; 160
      Enabled: true
      Name: Ground Grid
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: map
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Original World Geometry
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /drone/obstacle_markers
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Filled and Inflated Voxels
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /drone/voxel_markers
      Value: true

    - Alpha: 0.30
      Class: rviz_default_plugins/PointCloud2
      Color: 225; 225; 225
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: false
      Name: Inflated Voxel Cloud
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.025
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /drone/voxel_cloud
      Use Fixed Frame: true
      Value: false

  Enabled: true
  Global Options:
    Background Color: 30; 32; 38
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 24
      Focal Point:
        X: 4
        Y: 0
        Z: 2
      Pitch: 0.55
      Target Frame: map
      Yaw: 0.80
Window Geometry:
  Height: 900
  Width: 1450
