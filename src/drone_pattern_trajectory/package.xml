<?xml version="1.0"?>
<package format="3">
  <name>drone_pattern_trajectory</name>
  <version>0.1.0</version>
  <description>Circle and figure-eight trajectory tracking experiments.</description>
  <maintainer email="taccettabellus@gmail.com">Zhang Xianzhe</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
