Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Cell Size: 1
      Plane Cell Count: 30
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Frame Timeout: 15
      Marker Scale: 0.5
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Drone Markers
      Topic:
        Value: /visualization_marker_array
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Pattern Reference
      Topic:
        Value: /drone/pattern_reference
      Line Style: Lines
      Line Width: 0.04
      Color: 255; 170; 0
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Actual Flight Path
      Topic:
        Value: /drone/path
      Line Style: Lines
      Line Width: 0.05
      Color: 0; 220; 255
  Enabled: true
  Global Options:
    Background Color: 35; 37; 43
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Focal Point:
        X: 0
        Y: 0
        Z: 1.5
      Pitch: 0.65
      Yaw: 0.75
Window Geometry:
  Height: 900
  Width: 1450
